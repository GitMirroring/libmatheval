# Generate configure script and other files needed to build from the
# repository; release tarballs contain these files already.  Needs
# Autoconf, Automake and Libtool.

cd "`dirname "$0"`" || exit 1
mkdir -p m4 || exit 1
exec autoreconf --force --install "$@"
